OPENAI_API_KEY=
SKYFIRE_MCP_URL=https://mcp.skyfire.xyz/mcp
REPORTING_MCP_URL=
SKYFIRE_API_KEY=

# --- Rate limiting -----------------------------------------------------------
# All optional; the values shown are the built-in defaults. Unparseable values
# log a warning and fall back to the default rather than failing the app.

# Kill switch. Set false to disable all limiting (e.g. during a live demo).
RATE_LIMIT_ENABLED=true

# Per-IP: 10 runs per rolling hour, then a 3 hour block.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_BLOCK_MS=10800000

# Comma-separated IPs exempt from counting, e.g. "203.0.113.7,198.51.100.4".
# An IPv6 entry exempts its whole /64. Checked before counting.
RATE_LIMIT_ALLOWLIST=

# Service-wide circuit breaker. Bounds TOTAL spend, which a per-IP limit cannot:
# 10k rotated IPs x 10 runs would otherwise be 100k runs. Has no sticky block --
# it eases off by itself as the window slides, so a traffic spike cannot take
# the demo down for hours. Also still applies when IP resolution fails open.
RATE_LIMIT_GLOBAL_ENABLED=true
RATE_LIMIT_GLOBAL_MAX_REQUESTS=100
# Defaults to RATE_LIMIT_WINDOW_MS when unset.
RATE_LIMIT_GLOBAL_WINDOW_MS=3600000

# Trusted proxy hops to skip from the RIGHT of X-Forwarded-For. 0 = use the last
# entry. Only consulted when cf-connecting-ip / true-client-ip are absent.
# NEVER read XFF from the left: Render appends to the header without stripping a
# client-supplied value, so the leftmost entries are attacker-controlled.
# Calibrate with RATE_LIMIT_DEBUG_HEADERS before changing.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Logs the raw proxy headers so you can calibrate the hop count against real
# traffic. Turn off again afterwards: these lines contain visitor IPs.
RATE_LIMIT_DEBUG_HEADERS=false

# Memory caps for the in-memory store (LRU eviction past these).
RATE_LIMIT_MAX_TRACKED_IPS=20000
RATE_LIMIT_MAX_TRACKED_BLOCKS=5000

# Local dev only (ignored when NODE_ENV=production): treat every request as
# coming from this IP, since localhost sends no proxy headers.
RATE_LIMIT_DEV_FALLBACK_IP=
